rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role from custom claim first, fallback to Firestore users/{uid}
    function getRole() {
      return isAuthenticated()
        ? (request.auth.token.get('role', null) != null
            ? request.auth.token.role
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
                : null))
        : null;
    }

    function isEditor() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated();
    }

    // ─── members ────────────────────────────────────────────────────────────

    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ─── users ──────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ─── finances ───────────────────────────────────────────────────────────

    match /finances/{financeId} {
      allow read: if true;
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }

    // ─── tournaments ────────────────────────────────────────────────────────

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isEditor();

      // participants
      match /participants/{participantId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      // matches
      match /matches/{matchId} {
        allow read: if true;
        allow create, update, delete: if isEditor();

        match /scoreHistory/{historyId} {
          allow read: if true;
          allow create: if isEditor();
          allow update, delete: if false;
        }
      }

      match /draws/{drawId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      match /groups/{groupId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      match /teams/{teamId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if isEditor();
      }
    }

    // ─── auditLogs ──────────────────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
