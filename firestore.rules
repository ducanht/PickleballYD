rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role from custom claim first, fallback to Firestore users/{uid}
    function getRole() {
      return isAuthenticated()
        ? (request.auth.token.get('role', null) != null
            ? request.auth.token.role
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
                : null))
        : null;
    }

    function isEditor() {
      return isAuthenticated() && (getRole() == 'EDITOR' || getRole() == 'ADMIN');
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'ADMIN';
    }

    // ─── members ────────────────────────────────────────────────────────────

    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ─── users ──────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      // Own user may update non-role fields; admins can update anything
      allow update: if (isAuthenticated()
                        && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── finances ───────────────────────────────────────────────────────────

    match /finances/{financeId} {
      allow read: if isAuthenticated();
      allow create: if isEditor();
      // Void/edit restricted to ADMIN (immutable ledger per BR-009)
      allow update, delete: if isAdmin();
    }

    // ─── tournaments ────────────────────────────────────────────────────────

    match /tournaments/{tournamentId} {
      // Public read — Live Board & Public Standings require no auth
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor();
      // Delete only ADMIN + only DRAFT tournaments
      allow delete: if isAdmin() && resource.data.status == 'DRAFT';

      // participants
      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if isEditor();
        // Remove only when DRAFT
        allow delete: if isEditor()
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status == 'DRAFT';
      }

      // matches
      match /matches/{matchId} {
        allow read: if true;
        allow create: if isEditor();
        // EDITOR can update non-completed; ADMIN can always update (score correction)
        allow update: if isAdmin()
          || (isEditor() && resource.data.status != 'COMPLETED');
        allow delete: if isAdmin();

        // scoreHistory — immutable once written (BR-007)
        match /scoreHistory/{historyId} {
          allow read: if isEditor();
          allow create: if isEditor();
          allow update, delete: if false;
        }
      }

      // draws, groups, teams, events — same pattern
      match /draws/{drawId} {
        allow read: if true;
        allow create, update: if isEditor();
        allow delete: if isAdmin();
      }

      match /groups/{groupId} {
        allow read: if true;
        allow create, update: if isEditor();
        allow delete: if isAdmin();
      }

      match /teams/{teamId} {
        allow read: if true;
        allow create, update: if isEditor();
        allow delete: if isAdmin();
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update: if isEditor();
        allow delete: if isAdmin();
      }
    }

    // ─── auditLogs ──────────────────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Written by service layer
      allow update, delete: if false;     // Immutable
    }
  }
}
